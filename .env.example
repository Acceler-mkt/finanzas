# Copia este archivo como ".env.local" y rellena los dos valores de tu proyecto de Supabase
# (Project Settings → API). Sin ellos, la app arranca con datos de prueba.
# La clave "anon" es pública por diseño: lo que protege los datos son las reglas de la base de datos.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solo para la copia nocturna (npm run copia). Va en un archivo aparte, ".env.copia",
# que se queda en la torre. NUNCA la pongas en .env.local ni la subas a ningún sitio.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
